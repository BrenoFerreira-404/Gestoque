FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/Gestoque.Domain/Gestoque.Domain.csproj src/Gestoque.Domain/
COPY src/Gestoque.Application/Gestoque.Application.csproj src/Gestoque.Application/
COPY src/Gestoque.Infrastructure/Gestoque.Infrastructure.csproj src/Gestoque.Infrastructure/
COPY src/Gestoque.Web/Gestoque.Web.csproj src/Gestoque.Web/
RUN dotnet restore src/Gestoque.Web/Gestoque.Web.csproj

COPY src/ src/
RUN dotnet publish src/Gestoque.Web/Gestoque.Web.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Gestoque.Web.dll"]
