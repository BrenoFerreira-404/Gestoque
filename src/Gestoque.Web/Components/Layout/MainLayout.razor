@inherits LayoutComponentBase
@inject IMediator Mediator
@inject TenantSessionState TenantSession
@inject ITenantPersistenceService TenantPersistence

<RadzenComponents @rendermode="InteractiveServer" />
<RadzenDialog />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="width: 100%;">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenIcon Icon="inventory_2" />
            <RadzenLabel Text="GESTOQUE" Style="font-weight: 700; letter-spacing: 0.5px;" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="MULTI-EMPRESA" IsPill="true" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem"
                         JustifyContent="JustifyContent.End" Style="margin-left: auto;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="business" />
                    <RadzenText TextStyle="TextStyle.Caption">Empresa Ativa</RadzenText>
                    <RadzenDropDown TValue="Guid" Data="@tenants" TextProperty="NomeFantasia" ValueProperty="Id"
                                    Value="@currentTenantId" Change="@OnTenantSelectionChanged"
                                    Style="width: 220px;" />
                </RadzenStack>
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="SUPER ADMIN" IsPill="true" />
                <RadzenIcon Icon="account_circle" Style="font-size: 1.75rem;" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        <RadzenContentContainer Name="main">
            @Body
        </RadzenContentContainer>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui">
    Ocorreu um erro não tratado.
    <a href="" class="reload">Recarregar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool sidebarExpanded = true;
    private List<TenantDto> tenants = new();
    private Guid currentTenantId;

    protected override async Task OnInitializedAsync()
    {
        TenantSession.RegisterOnTenantChanged(StateHasChanged);
        TenantSession.RegisterOnTenantsChanged(() => InvokeAsync(LoadTenantsAsync));
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            tenants = await Mediator.Send(new GetTenantsQuery());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Erro ao carregar tenants: {ex.Message}");
            tenants = new();
        }

        if (!tenants.Any())
        {
            currentTenantId = Guid.Empty;
            StateHasChanged();
            return;
        }

        Guid? persistedTenantId = null;
        try
        {
            persistedTenantId = await TenantPersistence.GetLastSelectedTenantIdAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Erro ao ler tenant persistido: {ex.Message}");
        }

        TenantDto? match = persistedTenantId is not null
            ? tenants.FirstOrDefault(t => t.Id == persistedTenantId.Value)
            : null;
        if (match is null && TenantSession.SelectedTenantId is Guid sessionTenantId)
        {
            match = tenants.FirstOrDefault(t => t.Id == sessionTenantId);
        }
        match ??= tenants.First();

        currentTenantId = match.Id;
        TenantSession.SetTenant(match);
        _ = TenantPersistence.SetLastSelectedTenantIdAsync(match.Id);

        StateHasChanged();
    }

    private void OnTenantSelectionChanged(object value)
    {
        if (value is Guid tenantId)
        {
            var selected = tenants.FirstOrDefault(t => t.Id == tenantId);
            if (selected != null)
            {
                currentTenantId = tenantId;
                TenantSession.SetTenant(selected);
                _ = TenantPersistence.SetLastSelectedTenantIdAsync(tenantId);
                StateHasChanged();
            }
        }
    }
}
