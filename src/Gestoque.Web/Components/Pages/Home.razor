@page "/"
@inject IMediator Mediator
@inject TenantSessionState TenantSession
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Dashboard - Gestoque Pro</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" Style="margin: 0;">Painel de Controle</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2">
                Empresa Ativa: <strong>@TenantSession.SelectedTenantName</strong>
            </RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem">
            <RadzenButton Text="Registrar Entrada" Icon="input" ButtonStyle="ButtonStyle.Success"
                          Click="@(() => Navigation.NavigateTo("entradas"))" />
            <RadzenButton Text="Registrar Saída" Icon="output" ButtonStyle="ButtonStyle.Danger"
                          Click="@(() => Navigation.NavigateTo("saidas"))" />
        </RadzenStack>
    </RadzenStack>

    @if (loading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (kpis != null)
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Total de Itens</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@kpis.TotalProducts</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="inventory_2" Style="font-size: 2rem; color: var(--rz-primary);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">Produtos ativos no estoque</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard Style="border-left: 4px solid var(--rz-danger);">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Abaixo do Mínimo</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: var(--rz-danger);">@kpis.ProductsBelowMinimum</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="warning" Style="font-size: 2rem; color: var(--rz-danger);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">Necessitam de reposição urgente</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard Style="border-left: 4px solid var(--rz-warning);">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Próximos ao Vencimento</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: var(--rz-warning);">@kpis.ProductsExpiringSoon</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="schedule" Style="font-size: 2rem; color: var(--rz-warning);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-warning);">Vencem nos próximos 30 dias</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard Style="border-left: 4px solid var(--rz-danger-darker);">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Itens Vencidos</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: var(--rz-danger-darker);">@kpis.ProductsExpired</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="event_busy" Style="font-size: 2rem; color: var(--rz-danger-darker);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger-darker);">Bloqueados para consumo</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Entradas Registradas</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: var(--rz-success);">@kpis.TotalEntradasMonth.ToString("N0")</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="arrow_downward" Style="font-size: 2rem; color: var(--rz-success);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">Unidades recebidas no sistema</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6" SizeLG="4" SizeXL="2">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline">Saídas Registradas</RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: var(--rz-secondary);">@kpis.TotalSaidasMonth.ToString("N0")</RadzenText>
                        </RadzenStack>
                        <RadzenIcon Icon="arrow_upward" Style="font-size: 2rem; color: var(--rz-secondary);" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">Unidades consumidas/baixadas no sistema</RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem"
                         Style="margin-bottom: 1rem;">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H4" Style="margin: 0;">Itens que Exigem Atenção Imediata</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">Produtos abaixo do estoque mínimo ou com validade próxima</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    @if (selectedCriticalProductIds.Count > 0)
                    {
                        <RadzenButton Text="Dar saída nos selecionados" Icon="output" ButtonStyle="ButtonStyle.Danger"
                                      Click="ConfirmarDarSaidaSelecionadosAsync" />
                    }
                    <RadzenButton Text="Ver Posição Completa" Icon="chevron_right" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Navigation.NavigateTo("estoque"))" />
                </RadzenStack>
            </RadzenStack>

            <RadzenDataGrid Data="@criticalItems" TItem="PosicaoEstoqueDto" AllowPaging="true" PageSize="6"
                            EmptyText="Nenhum item crítico no momento!">
                <Columns>
                    <RadzenDataGridColumn TItem="PosicaoEstoqueDto" Title="Selecionar" Width="90px" Sortable="false">
                        <Template Context="item">
                            <input type="checkbox" checked="@IsCriticalProductSelected(item.ProductId)"
                                   @onchange="@(args => SetCriticalProductSelection(item.ProductId, args.Value is true))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="ProductName" Title="Alimento / Produto" Width="280px">
                        <Template Context="item">
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@item.ProductName</RadzenText>
                            @if (item.IsUniqueItem)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="ITEM ÚNICO" IsPill="true" Style="margin-left: 6px;" />
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="Brand" Title="Marca" Width="140px">
                        <Template Context="item">
                            @(string.IsNullOrEmpty(item.Brand) ? "-" : item.Brand)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="CurrentStock" Title="Saldo Atual" Width="120px">
                        <Template Context="item">
                            <RadzenText TextStyle="TextStyle.Body1"
                                        Style="@($"font-weight: 700; color: var(--rz-{(item.IsBelowMinimum ? "danger" : "success")});")">
                                @item.CurrentStock.ToString("N0") @item.Unit
                            </RadzenText>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="MinimumStock" Title="Estoque Mínimo" Width="120px">
                        <Template Context="item">
                            <span class="rz-color-secondary">@item.MinimumStock.ToString("N0") @item.Unit</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Property="NextExpiryDate" Title="Próxima Validade" Width="160px">
                        <Template Context="item">
                            @if (item.NextExpiryDate.HasValue)
                            {
                                @if (item.ExpiryStatus == ExpiryStatus.Vencido)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@($"{item.NextExpiryDate:dd/MM/yyyy} (VENCIDO)")" />
                                }
                                else if (item.ExpiryStatus == ExpiryStatus.Critico || item.ExpiryStatus == ExpiryStatus.ProximoVencimento)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{item.NextExpiryDate:dd/MM/yyyy} (VENCE LOGO)")" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"{item.NextExpiryDate:dd/MM/yyyy}")" />
                                }
                            }
                            else
                            {
                                <span class="rz-color-secondary">Não informada</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="Ação" Width="130px" Sortable="false">
                        <Template Context="item">
                            <RadzenButton Text="Dar Saída" Icon="output" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Click="@(() => Navigation.NavigateTo($"saidas?productId={item.ProductId}"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private bool loading = true;
    private DashboardKpisDto? kpis;
    private List<PosicaoEstoqueDto> criticalItems = new();
    private HashSet<Guid> selectedCriticalProductIds = new();
    private IDisposable? _tenantChangedRegistration;

    protected override async Task OnInitializedAsync()
    {
        _tenantChangedRegistration = TenantSession.RegisterOnTenantChanged(() =>
        {
            try
            {
                InvokeAsync(LoadDashboardDataAsync);
            }
            catch
            {
                // silencioso para não quebrar o circuito no startup
            }
            StateHasChanged();
        });
        await LoadDashboardDataAsync();
    }

    public void Dispose()
    {
        _tenantChangedRegistration?.Dispose();
    }

    private async Task LoadDashboardDataAsync()
    {
        if (!TenantSession.SelectedTenantId.HasValue)
        {
            kpis = null;
            criticalItems = new();
            loading = false;
            StateHasChanged();
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            kpis = await Mediator.Send(new GetDashboardKpisQuery());
            var allStock = await Mediator.Send(new GetPosicaoEstoqueQuery());
            criticalItems = allStock
                .Where(p => p.CurrentStock > 0
                    && (p.IsBelowMinimum
                        || p.ExpiryStatus == ExpiryStatus.ProximoVencimento
                        || p.ExpiryStatus == ExpiryStatus.Critico
                        || p.ExpiryStatus == ExpiryStatus.Vencido))
                .Take(10)
                .ToList();
            selectedCriticalProductIds.RemoveWhere(id => criticalItems.All(item => item.ProductId != id));
        }
        catch (Exception ex)
        {
            kpis = null;
            criticalItems = new();
            Console.WriteLine($"[Home] Erro ao carregar dashboard: {ex.Message}");
            NotificationService.Notify(NotificationSeverity.Error, "Erro ao carregar dashboard", ex.Message);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private bool IsCriticalProductSelected(Guid productId) => selectedCriticalProductIds.Contains(productId);

    private void SetCriticalProductSelection(Guid productId, bool selected)
    {
        if (selected)
            selectedCriticalProductIds.Add(productId);
        else
            selectedCriticalProductIds.Remove(productId);
    }

    private async Task DarSaidaSelecionadosAsync()
    {
        if (selectedCriticalProductIds.Count == 0)
            return;

        var exited = await Mediator.Send(new RegistrarSaidaProdutosCommand(selectedCriticalProductIds.ToList()));
        selectedCriticalProductIds.Clear();
        NotificationService.Notify(NotificationSeverity.Success, "Saídas registradas", $"Saída registrada para {exited} produto(s). Os cadastros foram preservados.");
        await LoadDashboardDataAsync();
    }

    private async Task ConfirmarDarSaidaSelecionadosAsync()
    {
        if (await DialogService.Confirm("Tem certeza que deseja dar saída de todo o saldo dos itens selecionados?", "Confirmar saídas", new ConfirmOptions { OkButtonText = "Sim", CancelButtonText = "Não" }) == true)
            await DarSaidaSelecionadosAsync();
    }
}
