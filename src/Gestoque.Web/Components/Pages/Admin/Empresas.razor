@page "/empresas"
@inject IMediator Mediator
@inject TenantSessionState TenantSession
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Empresas - Gestoque Pro</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem;">
    <div>
        <h2 style="font-weight: 700; color: #111827; margin: 0 0 0.25rem 0; font-size: 1.35rem;">Gestão Multi-Empresa</h2>
        <p style="color: #6b7280; margin: 0; font-size: 0.9rem;">
            Cadastre empresas e gerencie estoques isolados sem misturar dados
        </p>
    </div>

    <RadzenButton Text="Cadastrar Nova Empresa" Icon="add_business" ButtonStyle="ButtonStyle.Primary" Click="@(() => showModal = true)" />
</div>

@if (loading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 1.5rem;" />
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem;">
        @foreach (var tenant in tenants)
        {
            var isCurrent = tenant.Id == TenantSession.SelectedTenantId;

            <RadzenCard Style="@($"background: #ffffff; border-radius: 12px; padding: 1.5rem; border: 1px solid {(isCurrent ? "#d1d5db" : "#e5e7eb")}; box-shadow: 0 1px 2px rgba(0,0,0,0.03);")">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                            <RadzenIcon Icon="business" Style="font-size: 1.1rem; color: #6b7280;" />
                            <h4 style="margin: 0; font-weight: 700; color: #111827; font-size: 1.05rem;">@tenant.NomeFantasia</h4>
                        </div>
                        <p style="margin: 0; font-size: 0.85rem; color: #6b7280; padding-left: 1.5rem;">@tenant.RazaoSocial</p>
                    </div>
                    @if (isCurrent)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="ATIVA" IsPill="true" Style="background-color: #f3f4f6; color: #374151; border: 1px solid #d1d5db; font-weight: 600;" />
                    }
                </div>

                <div style="background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 10px; padding: 0.85rem 1rem; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #4b5563;">
                        <RadzenIcon Icon="badge" Style="font-size: 0.95rem; color: #9ca3af; width: 1rem;" />
                        <span style="color: #6b7280; min-width: 3.5rem;">CNPJ</span>
                        <strong>@(string.IsNullOrEmpty(tenant.Cnpj) ? "-" : tenant.Cnpj)</strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #4b5563;">
                        <RadzenIcon Icon="email" Style="font-size: 0.95rem; color: #9ca3af; width: 1rem;" />
                        <span style="color: #6b7280; min-width: 3.5rem;">E-mail</span>
                        <strong>@(string.IsNullOrEmpty(tenant.Email) ? "-" : tenant.Email)</strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #4b5563;">
                        <RadzenIcon Icon="phone" Style="font-size: 0.95rem; color: #9ca3af; width: 1rem;" />
                        <span style="color: #6b7280; min-width: 3.5rem;">Telefone</span>
                        <strong>@(string.IsNullOrEmpty(tenant.Telefone) ? "-" : tenant.Telefone)</strong>
                    </div>
                </div>

                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                    @if (!isCurrent)
                    {
                        <RadzenButton Text="Acessar Estoque" Icon="login" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => SelecionarEmpresa(tenant))" />
                    }
                    else
                    {
                        <RadzenButton Text="Gerenciar Estoque" Icon="inventory_2" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => Navigation.NavigateTo("estoque"))" />
                    }
                    <RadzenButton Text="Excluir" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => empresaParaExcluir = tenant)" />
                </div>
            </RadzenCard>
        }
    </div>
}

@if (empresaParaExcluir != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <RadzenCard Style="background: #ffffff; border-radius: 14px; width: 460px; max-width: 95vw; padding: 1.75rem;">
            <h4 style="margin: 0 0 0.75rem 0;">Excluir empresa?</h4>
            <p style="margin: 0 0 1.25rem 0; color: #4b5563;">
                A empresa <strong>@empresaParaExcluir.NomeFantasia</strong> e todos os produtos, lotes, movimentos, doações, fornecedores e categorias serão apagados permanentemente.
            </p>
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@(() => empresaParaExcluir = null)" />
                <RadzenButton Text="Excluir permanentemente" Icon="delete_forever" ButtonStyle="ButtonStyle.Danger" Click="ExcluirEmpresaAsync" />
            </div>
        </RadzenCard>
    </div>
}

<!-- MODAL CADASTRAR EMPRESA -->
@if (showModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <RadzenCard Style="background: #ffffff; border-radius: 14px; width: 480px; max-width: 95vw; padding: 1.75rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);">
            <h4 style="margin: 0 0 1.5rem 0; font-weight: 700; color: #111827; font-size: 1.1rem;">Cadastrar Nova Empresa</h4>

            <div style="display: flex; flex-direction: column; gap: 1.1rem;">
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem;">Nome Fantasia *</label>
                    <RadzenTextBox @bind-Value="@newNomeFantasia" Placeholder="Ex: Unidade Centro..." Style="width: 100%;" />
                </div>

                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem;">Razão Social *</label>
                    <RadzenTextBox @bind-Value="@newRazaoSocial" Placeholder="Ex: Empresa de Alimentos Ltda..." Style="width: 100%;" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem;">CNPJ</label>
                        <RadzenTextBox @bind-Value="@newCnpj" Placeholder="00.000.000/0001-00" Style="width: 100%;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem;">Telefone</label>
                        <RadzenTextBox @bind-Value="@newTelefone" Placeholder="(11) 99999-9999" Style="width: 100%;" />
                    </div>
                </div>

                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem;">E-mail Corporativo</label>
                    <RadzenTextBox @bind-Value="@newEmail" Placeholder="contato@empresa.com.br" Style="width: 100%;" />
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.75rem;">
                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@(() => showModal = false)" />
                    <RadzenButton Text="Criar Empresa" ButtonStyle="ButtonStyle.Primary" Click="@ConfirmarSalvarEmpresaAsync" />
                </div>
            </div>
        </RadzenCard>
    </div>
}

@code {
    private bool loading = true;
    private List<TenantDto> tenants = new();
    private bool showModal = false;
    private TenantDto? empresaParaExcluir;

    private string newNomeFantasia = string.Empty;
    private string newRazaoSocial = string.Empty;
    private string newCnpj = string.Empty;
    private string? newEmail;
    private string? newTelefone;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        loading = true;
        try
        {
            tenants = await Mediator.Send(new GetTenantsQuery());
        }
        finally
        {
            loading = false;
        }
    }

    private void SelecionarEmpresa(TenantDto tenant)
    {
        TenantSession.SetTenant(tenant);
        NotificationService.Notify(NotificationSeverity.Info, "Empresa Alterada", $"Você agora está gerenciando: {tenant.NomeFantasia}");
        Navigation.NavigateTo("/produtos");
    }

    private async Task SalvarEmpresaAsync()
    {
        if (string.IsNullOrWhiteSpace(newNomeFantasia) || string.IsNullOrWhiteSpace(newRazaoSocial))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atenção", "Preencha o Nome Fantasia e a Razão Social.");
            return;
        }

        try
        {
            var newId = await Mediator.Send(new CreateTenantCommand(
                RazaoSocial: newRazaoSocial,
                NomeFantasia: newNomeFantasia,
                Cnpj: newCnpj,
                Email: newEmail,
                Telefone: newTelefone
            ));

            NotificationService.Notify(NotificationSeverity.Success, "Sucesso", "Empresa cadastrada com sucesso!");

            newNomeFantasia = string.Empty;
            newRazaoSocial = string.Empty;
            newCnpj = string.Empty;
            newEmail = null;
            newTelefone = null;
            showModal = false;

            await LoadTenantsAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erro ao criar empresa", ex.Message);
        }
    }

    private async Task ConfirmarSalvarEmpresaAsync()
    {
        if (await DialogService.Confirm("Tem certeza que deseja cadastrar esta empresa?", "Confirmar cadastro", new ConfirmOptions { OkButtonText = "Sim", CancelButtonText = "Não" }) == true)
            await SalvarEmpresaAsync();
    }

    private async Task ExcluirEmpresaAsync()
    {
        if (empresaParaExcluir == null)
            return;

        var tenant = empresaParaExcluir;
        try
        {
            await Mediator.Send(new DeleteTenantCommand(tenant.Id));
            if (TenantSession.SelectedTenantId == tenant.Id)
                Navigation.NavigateTo("/");

            empresaParaExcluir = null;
            await LoadTenantsAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Empresa excluída", "A empresa e seus dados foram removidos.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erro ao excluir empresa", ex.Message);
        }
    }
}

