@page "/importar-excel"
@using Microsoft.AspNetCore.Components.Forms
@using Gestoque.Infrastructure.Services
@inject ExcelImporterService ExcelImporter
@inject TenantSessionState TenantSession
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>Importar Planilha Excel - Gestoque Pro</PageTitle>

<RadzenStack Gap="1.5rem" Style="max-width: 800px;">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" Style="margin: 0;">Migração e Importação da Planilha Excel</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">
            Envie uma planilha compatível com as abas ESTOQUE, ENTRADA ENTREGA e DOAÇÃO.
        </RadzenText>
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Gap="1.5rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenIcon Icon="table_view" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H4" Style="margin: 0;">Importar Planilha</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">Selecione um arquivo <strong>.xlsx</strong> para iniciar a importação.</RadzenText>
                </RadzenStack>
            </RadzenStack>

            <RadzenFieldset Text="O que será importado">
                <RadzenStack Gap="0.35rem">
                    <RadzenText TextStyle="TextStyle.Body2"><strong>Aba ESTOQUE:</strong> Produtos, marcas, saldos e lotes de migração.</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2"><strong>Aba ENTRADA ENTREGA:</strong> Fornecedores e histórico de recebimento.</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2"><strong>Aba SAÍDA:</strong> Histórico de saídas diárias por consumo/perdas.</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2"><strong>Aba DOAÇÃO:</strong> Rastreabilidade de alimentos doados.</RadzenText>
                </RadzenStack>
            </RadzenFieldset>

            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="business" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.Caption">Empresa de Destino da Importação</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 700;">@TenantSession.SelectedTenantName</RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenAlert>

            <RadzenStack Gap="1rem">
                <InputFile id="excelFile" OnChange="OnFileSelected" accept=".xlsx,.xls" />

                @if (!string.IsNullOrEmpty(fileName))
                {
                    <RadzenText TextStyle="TextStyle.Body2">Arquivo selecionado: <strong>@fileName</strong></RadzenText>
                }

                <RadzenButton Text="Iniciar Importação Agora" Icon="cloud_upload" ButtonStyle="ButtonStyle.Success"
                              Click="@ExecutarImportacaoAsync" Disabled="@(!HasFile || isImporting)"
                              Style="height: 48px; width: 100%;" />
            </RadzenStack>

            @if (isImporting)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem 0;">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="width: 100%;" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                        Importando dados e criando lotes com validade no banco... Aguarde um momento.
                    </RadzenText>
                </RadzenStack>
            }
            else if (importResult != null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="check_circle" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 700;">Importação Concluída com Sucesso!</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2">
                            • <strong>@importResult.Value.products</strong> produtos cadastrados/atualizados.<br />
                            • <strong>@importResult.Value.suppliers</strong> fornecedores identificados e cadastrados.<br />
                            • <strong>@importResult.Value.movements</strong> lotes com saldos e validades importados.
                        </RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem">
                            <RadzenButton Text="Visualizar Posição do Estoque" Icon="table_chart" ButtonStyle="ButtonStyle.Success"
                                          Click="@(() => Navigation.NavigateTo("estoque"))" />
                            <RadzenButton Text="Ir para o Dashboard" Icon="dashboard" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => Navigation.NavigateTo(""))" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenAlert>
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private bool isImporting = false;
    private (int products, int suppliers, int movements)? importResult;
    private IBrowserFile? selectedFile;
    private string? fileName;
    private bool HasFile => selectedFile is not null;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileName = selectedFile.Name;
    }

    private async Task ExecutarImportacaoAsync()
    {
        if (!TenantSession.SelectedTenantId.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atenção", "Nenhuma empresa ativa selecionada.");
            return;
        }

        if (selectedFile is null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atenção", "Selecione um arquivo .xlsx para importar.");
            return;
        }

        isImporting = true;
        importResult = null;

        var tempPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".xlsx");

        try
        {
            await using (var uploadStream = selectedFile.OpenReadStream(maxAllowedSize: 1024L * 1024L * 1024L))
            await using (var fileStream = new FileStream(tempPath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, useAsync: true))
            {
                await uploadStream.CopyToAsync(fileStream);
            }

            importResult = await ExcelImporter.ImportFromExcelAsync(tempPath, TenantSession.SelectedTenantId.Value);

            NotificationService.Notify(NotificationSeverity.Success, "Sucesso", "Importação concluída com sucesso!");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erro na importação", ex.Message);
        }
        finally
        {
            if (File.Exists(tempPath))
            {
                try { File.Delete(tempPath); } catch { /* ignorar falha ao limpar temp */ }
            }
            isImporting = false;
        }
    }
}
